<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d1117"
    android:padding="8dp">

    <!-- Status bar -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hermes-Clean Shell"
        android:textColor="#c9d1d9"
        android:textSize="12sp"
        android:padding="4dp"
        android:gravity="center" />

    <!-- Warning -->
    <TextView
        android:id="@+id/warning_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Safe-local mode. 127.0.0.1 на телефоне НЕ подключится к ПК."
        android:textColor="#d2991d"
        android:textSize="11sp"
        android:padding="4dp"
        android:visibility="visible"
        android:background="#1a1200" />

    <!-- URL input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <EditText
            android:id="@+id/url_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="http://127.0.0.1:8514"
            android:textColor="#c9d1d9"
            android:background="#21262d"
            android:padding="8dp"
            android:textSize="13sp"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btn_save_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾"
            android:textSize="14sp"
            android:backgroundTint="#30363d" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Открыть UI"
            android:backgroundTint="#7c3aed" />

        <Button
            android:id="@+id/btn_check_api"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Проверить API"
            android:backgroundTint="#30363d" />
    </LinearLayout>

    <!-- Error screen -->
    <LinearLayout
        android:id="@+id/error_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌ API недоступен"
            android:textColor="#f85149"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Запустите Hermes-Clean на ПК:\nscripts\\hermes.cmd mobile-api-server-check\n\nЗатем измените URL на IP ПК\n(требуется LAN/Tailscale/VPN)."
            android:textColor="#8b949e"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>

    <!-- WebView -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
